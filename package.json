{
  "name": "ared-ndawune-mobile",
  "version": "1.5.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "verifier:bundle": "bash scripts/verifier-bundle.sh",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@config-plugins/react-native-pdf": "~14.0.2",
    "@expo/config-plugins": "~58.0.0",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^0.24.9",
    "react-native-pdf": "^7.0.4",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "~0.88.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "expo-secure-store": "<rootDir>/src/__mocks__/expo-secure-store.ts",
      "expo-sqlite": "<rootDir>/src/__mocks__/expo-sqlite.ts",
      "@react-native-async-storage/async-storage": "<rootDir>/src/__mocks__/async-storage.ts",
      "expo-router": "<rootDir>/src/__mocks__/expo-router.ts",
      "react-native-safe-area-context": "<rootDir>/src/__mocks__/react-native-safe-area-context.ts"
    },
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts",
      "<rootDir>/src/__tests__/**/*.test.tsx"
    ]
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ws": "^8.18.1"
  }
}
