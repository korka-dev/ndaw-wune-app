{
  "name": "ared-ndawune-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "verifier:bundle": "bash scripts/verifier-bundle.sh"
  },
  "dependencies": {
    "@config-plugins/react-native-pdf": "~14.0.2",
    "@expo/config-plugins": "~57.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.14",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.9",
    "react-native-pdf": "^7.0.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "~0.86.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "expo-secure-store": "<rootDir>/src/__mocks__/expo-secure-store.ts",
      "expo-sqlite": "<rootDir>/src/__mocks__/expo-sqlite.ts",
      "@react-native-async-storage/async-storage": "<rootDir>/src/__mocks__/async-storage.ts",
      "expo-router": "<rootDir>/src/__mocks__/expo-router.ts",
      "react-native-safe-area-context": "<rootDir>/src/__mocks__/react-native-safe-area-context.ts"
    },
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts",
      "<rootDir>/src/__tests__/**/*.test.tsx"
    ]
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ws": "^8.18.1"
  }
}
