{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "expo prebuild --clean --platform android",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "prebuildCommand": "expo prebuild --clean",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.ndawwune.cloud/api/v1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "prebuildCommand": "expo prebuild --clean",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.ndawwune.cloud/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
