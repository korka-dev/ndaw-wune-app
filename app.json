{
  "expo": {
    "name": "ARED NdawWune",
    "slug": "ared-ndawune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "sn.aroka.ared.ndawune",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "sn.aroka.ared.ndawune",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ndaw Wune utilise la galerie pour joindre une photo de la classe au rapport.",
          "cameraPermission": "Ndaw Wune utilise l'appareil photo pour prendre une photo de la classe lors de la soumission du rapport."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a56db",
          "sounds": [
            "./assets/sounds/finactivite.mp3",
            "./assets/sounds/30minutes.mp3",
            "./assets/sounds/5minutes.mp3"
          ]
        }
      ]
    ],
    "scheme": "ared-ndawune",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "864f56bb-cd8e-4670-bdc1-316fbe10ad60"
      }
    }
  }
}
