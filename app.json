{
  "expo": {
    "name": "ARED NdawWune",
    "slug": "ared-ndawune",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/ared-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ared-adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "sn.aroka.ared.ndawune",
      "versionCode": 130,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "sn.aroka.ared.ndawune",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "@config-plugins/react-native-pdf",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ndaw Wune utilise la galerie pour joindre une photo de la classe au rapport.",
          "cameraPermission": "Ndaw Wune utilise l'appareil photo pour prendre une photo de la classe lors de la soumission du rapport."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/ared-icon.png",
          "color": "#1a56db",
          "sounds": [
            "./assets/sounds/finactivite.mp3",
            "./assets/sounds/rappel_30min.mp3",
            "./assets/sounds/rappel_5min.mp3"
          ]
        }
      ],
      "expo-secure-store",
      "expo-file-system",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ndaw Wune utilise Face ID pour verrouiller l'accès à l'application."
        }
      ],
      "expo-audio",
      "expo-status-bar",
      "expo-asset"
    ],
    "scheme": "ared-ndawune",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/b6792591-faf5-45d9-9ed0-989290a9c50c"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6792591-faf5-45d9-9ed0-989290a9c50c"
      }
    }
  }
}
