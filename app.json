{
  "expo": {
    "name": "ARED NdawWune",
    "slug": "ared-ndawune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "sn.aroka.ared.ndawune",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "sn.aroka.ared.ndawune",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      "@config-plugins/react-native-pdf",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ndaw Wune utilise la galerie pour joindre une photo de la classe au rapport.",
          "cameraPermission": "Ndaw Wune utilise l'appareil photo pour prendre une photo de la classe lors de la soumission du rapport."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a56db",
          "sounds": [
            "./assets/sounds/finactivite.mp3",
            "./assets/sounds/rappel_30min.mp3",
            "./assets/sounds/rappel_5min.mp3"
          ]
        }
      ],
      "expo-secure-store",
      "expo-file-system"
    ],
    "scheme": "ared-ndawune",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91bca334-75fc-4ac0-acd0-c7bed545c24c"
      }
    },
    "owner": "rassoul-gby"
  }
}
