{
  "expo": {
    "name": "ARED NdawWune",
    "slug": "ared-ndawune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "sn.aroka.ared.ndawune",
      "minSdkVersion": 24,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "sn.aroka.ared.ndawune",
      "supportsTablet": false,
      "minimumOsVersion": "15.1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ndaw Wune utilise la galerie pour joindre une photo de la classe au rapport.",
          "cameraPermission": "Ndaw Wune utilise l'appareil photo pour prendre une photo de la classe lors de la soumission du rapport."
        }
      ],
      ["expo-sqlite", { "enableFTS": true }],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a56db",
          "sounds": [
            "./assets/sounds/alerte_30min.wav",
            "./assets/sounds/alerte_5min.wav"
          ]
        }
      ]
    ],
    "scheme": "ared-ndawune",
    "experiments": {
      "typedRoutes": true
    }
  }
}