{
  "expo": {
    "name": "ARED NdawWune",
    "slug": "ared-ndawune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a56db"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "sn.aroka.ared.ndawune",
      "minSdkVersion": 24,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "sn.aroka.ared.ndawune",
      "supportsTablet": false,
      "minimumOsVersion": "15.1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-sqlite", { "enableFTS": true }],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a56db",
          "sounds": []
        }
      ]
    ],
    "scheme": "ared-ndawune",
    "experiments": {
      "typedRoutes": true
    }
  }
}