# ── Configuration de l'API NdawWune ──────────────────────────────────────────
# Copier ce fichier en .env.local et adapter la valeur selon l'environnement.

# Développement local (émulateur Android)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Développement local (Wi-Fi, remplacer par votre IP)
# EXPO_PUBLIC_API_URL=http://192.168.X.X:8000/api/v1

# Production
# EXPO_PUBLIC_API_URL=https://api.ndawwune.cloud/api/v1
